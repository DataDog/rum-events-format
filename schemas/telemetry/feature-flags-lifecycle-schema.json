{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "telemetry/feature-flags-lifecycle-schema.json",
  "title": "TelemetryFeatureFlagsLifecycleEvent",
  "type": "object",
  "description": "Schema of Feature Flags SDK lifecycle telemetry events",
  "allOf": [
    {
      "$ref": "_common-schema.json"
    },
    {
      "required": ["service", "source", "telemetry"],
      "properties": {
        "service": {
          "type": "string",
          "description": "The SDK generating the telemetry event",
          "pattern": "^browser-feature-flags-sdk$"
        },
        "source": {
          "type": "string",
          "description": "The source of this event",
          "enum": [
            "android",
            "ios",
            "browser",
            "flutter",
            "react-native",
            "unity",
            "kotlin-multiplatform",
            "electron",
            "cpp",
            "maui"
          ],
          "pattern": "^browser$",
          "readOnly": true
        },
        "telemetry": {
          "type": "object",
          "description": "A bounded Feature Flags SDK lifecycle transition",
          "additionalProperties": false,
          "required": [
            "type",
            "product",
            "event_type",
            "timestamp",
            "runtime_id",
            "sequence",
            "sdk_name",
            "sdk_version"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "Telemetry payload discriminator",
              "const": "feature_flags_lifecycle"
            },
            "product": {
              "type": "string",
              "description": "Product producing the lifecycle event",
              "const": "feature_flags"
            },
            "event_type": {
              "type": "string",
              "description": "Feature Flags SDK lifecycle transition",
              "enum": [
                "sdk_init_started",
                "configuration_received",
                "provider_ready",
                "provider_error",
                "first_evaluation",
                "init_timeout",
                "init_failed"
              ]
            },
            "timestamp": {
              "type": "integer",
              "description": "Time at which the SDK observed the transition, in milliseconds from epoch",
              "minimum": 0
            },
            "runtime_id": {
              "type": "string",
              "description": "Random identifier generated once for this SDK runtime",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "sequence": {
              "type": "integer",
              "description": "Monotonically increasing sequence within the SDK runtime",
              "minimum": 1
            },
            "application_id": {
              "type": "string",
              "description": "Optional browser or mobile application identifier",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "environment_name": {
              "type": "string",
              "description": "Feature Flags environment supplied to the SDK",
              "minLength": 1,
              "maxLength": 200
            },
            "sdk_name": {
              "type": "string",
              "description": "Name of the Feature Flags SDK",
              "minLength": 1,
              "maxLength": 100
            },
            "sdk_version": {
              "type": "string",
              "description": "Version of the Feature Flags SDK",
              "minLength": 1,
              "maxLength": 100
            },
            "configuration_source": {
              "type": "string",
              "description": "Source from which the active flag configuration was obtained",
              "enum": ["remote", "cache"]
            },
            "configuration_version": {
              "type": "string",
              "description": "Opaque version of the active flag configuration",
              "minLength": 1,
              "maxLength": 200
            },
            "configuration_fetched_at": {
              "type": "integer",
              "description": "Time at which the active flag configuration was fetched, in milliseconds from epoch",
              "minimum": 0
            },
            "provider_status": {
              "type": "string",
              "description": "Feature Flags provider status after the lifecycle transition",
              "enum": ["ready", "stale", "error"]
            },
            "init_latency_ms": {
              "type": "integer",
              "description": "Elapsed time between SDK initialization starting and terminating",
              "minimum": 0
            },
            "evaluation_reporting_enabled": {
              "type": "boolean",
              "description": "Whether full flag evaluation reporting is enabled"
            },
            "error_code": {
              "type": "string",
              "description": "Fixed customer-safe error classification",
              "enum": ["precomputed_assignments_fetch_failed", "initialization_timeout", "initialization_failed"]
            }
          }
        }
      }
    }
  ]
}
